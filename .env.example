# SERVER-SIDE ONLY. This template intentionally contains no real credentials.
# For local Cloudflare/Vinext development use .dev.vars (see docs/API_KEYS.md).
# For hosting, add these as runtime environment variables/secrets, then redeploy.

# Enables generated answers in Ask your situation. Blank = curated API retrieval.
OPENAI_API_KEY=
# Optional model setting; requires Responses API and web_search support.
OPENAI_MODEL=gpt-4.1-mini

# Optional official government dataset integration. Supply BOTH values.
DATA_GOV_API_KEY=
# UUID from the API page of your chosen, verified data.gov.in resource.
DATA_GOV_RESOURCE_ID=
